# Copy to .env and adjust for your local Postgres install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolos?schema=public"

NODE_ENV=development
PORT=3000

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Phase 4 notification providers — "none" (default) keeps them unconfigured;
# in-app notifications and communication history work regardless.
EMAIL_PROVIDER=none
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none
