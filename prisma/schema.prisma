// SchoolOS: Prisma schema for Phase 0 (Foundation) + Phase 1 (Core School)
//
// See CLAUDE.md for the rules this schema encodes:
// - every tenant-owned table carries tenantId, indexed
// - money/decimal, state machines, and audit logging land in later phases,
//   but the shell (AuditLog, NumberingSequence) is built now
// - nothing here should make Phase 2+ (fees, payroll, HR) awkward to attach

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform / Foundation
// ─────────────────────────────────────────────────────────────────────────

/// A school group. All tenant-owned records reference tenantId, either
/// directly or transitively; never trust a client-supplied tenantId;
/// it must come from the authenticated session.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  timezone  String       @default("Africa/Lagos")
  /// Admin-customizable color scheme (Settings > Appearance), applied
  /// tenant-wide as CSS custom properties (--brand-primary/--brand-sidebar
  /// in styles.css), never resolves for another tenant since it's read via
  /// GET /tenants/me/branding, scoped to the caller's own tenantId.
  primaryColor String     @default("#176a50")
  sidebarColor String     @default("#123a31")
  /// Rest of Settings > Branding: a pasted logo image URL (no file-upload
  /// storage module exists yet, see CLAUDE.md's Phase 0 file-storage note
  /// — this is the honest scoped-down version of that) and the copy shown
  /// on both login screens' visual panel. Same tenant-scoping rules as the
  /// colors above: read/written only via /tenants/me/branding.
  logoUrl       String?
  loginHeadline String  @default("Welcome to your school portal.")
  loginSubtext  String  @default("Sign in to continue.")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  campuses           Campus[]
  users              User[]
  academicSessions   AcademicSession[]
  schoolClasses      SchoolClass[]
  students           Student[]
  guardians          Guardian[]
  staffProfiles      StaffProfile[]
  subjects           Subject[]
  attendanceRecords  AttendanceRecord[]
  results            Result[]
  auditLogs          AuditLog[]
  numberingSequences NumberingSequence[]

  notifications     Notification[]
  messageTemplates  MessageTemplate[]
  communicationLogs CommunicationLog[]
  assignments       Assignment[]
  lessons           Lesson[]
  announcements     Announcement[]
  cbtExams          CbtExam[]
  timetableSlots    TimetableSlot[]
  gradeBands        GradeBand[]
  streamChangeRequests StreamChangeRequest[]
  timetableSettings TimetableSettings?
  documentTemplates DocumentTemplate[]
  studentSubjectSelections StudentSubjectSelection[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// A physical campus/branch under a Tenant. A school group with a single
/// site still gets exactly one Campus row: nothing downstream should
/// special-case "no campus."
model Campus {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userCampusScopes  UserCampusScope[]
  schoolClasses     SchoolClass[]
  students          Student[]
  staffProfiles     StaffProfile[]
  attendanceRecords AttendanceRecord[]
  announcements     Announcement[]

  @@index([tenantId])
  @@map("campuses")
}

/// SUPER_ADMIN is a platform role and is the only role that may have
/// tenantId = null (see User.tenantId being optional). Every other role
/// belongs to exactly one tenant.
enum Role {
  SUPER_ADMIN
  PROPRIETOR
  PRINCIPAL
  BURSAR
  HR_ADMIN
  TEACHER
  PARENT
  STUDENT
  TRANSPORT_STAFF
  LIBRARY_STAFF
  OTHER_STAFF
  COMPLIANCE_ADMIN
}

/// Login identity. Role grants module-level actions (enforced in app code
/// via guards, not in the schema); UserCampusScope narrows that further to
/// specific campuses. A Proprietor with no scope rows has access to every
/// campus in their tenant; narrower roles (e.g. Bursar for one campus)
/// get explicit UserCampusScope rows.
model User {
  id           String  @id @default(uuid())
  tenantId     String? // null only for SUPER_ADMIN
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean @default(true)

  // MFA: mandatory for PROPRIETOR, BURSAR, HR_ADMIN, SUPER_ADMIN at the
  // application layer; schema supports it for every role.
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campusScopes    UserCampusScope[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  staffProfile    StaffProfile?
  guardianProfile Guardian?
  studentProfile  Student?          @relation("StudentUserAccount")

  recordedAttendance AttendanceRecord[] @relation("AttendanceRecordedBy")
  enteredResults     Result[]           @relation("ResultEnteredBy")

  notificationsReceived  Notification[]     @relation("NotificationRecipient")
  communicationsSent     CommunicationLog[] @relation("CommunicationSender")
  communicationsReceived CommunicationLog[] @relation("CommunicationRecipient")
  announcementsCreated   Announcement[]
  streamChangeRequestsReviewed StreamChangeRequest[]
  documentTemplatesUpdated DocumentTemplate[] @relation("DocumentTemplateUpdatedBy")

  @@index([tenantId])
  @@map("users")
}

/// Explicit campus scoping for a user within their tenant. Absence of any
/// row for a user with a group-wide role (Proprietor) means "all campuses";
/// for narrower roles, absence means "no campus access" (deny by default).
model UserCampusScope {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([userId, campusId])
  @@index([campusId])
  @@map("user_campus_scopes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Immutable audit trail. Every write to attendance corrections, result
/// approvals, permission changes, and (in later phases) payments/payroll
/// must produce a row here. Never update or delete rows in this table from
/// application code.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "ATTENDANCE_CORRECTED", "RESULT_PUBLISHED", "ROLE_CHANGED"
  entityType String // e.g. "AttendanceRecord", "Result", "User"
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Backing store for generated, gap-free-per-scope numbers: student IDs,
/// invoice numbers, receipt numbers, payroll run numbers. Fees/payroll
/// modules land in later phases but should consume this table rather than
/// each inventing its own counter.
model NumberingSequence {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope     String // e.g. "STUDENT_ID", "INVOICE", "RECEIPT", "PAYROLL_RUN"
  prefix    String   @default("")
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, scope])
  @@map("numbering_sequences")
}

// ─────────────────────────────────────────────────────────────────────────
// Core School: Academic structure
// ─────────────────────────────────────────────────────────────────────────

model AcademicSession {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  terms               Term[]
  studentClassHistory StudentClassHistory[]
  results             Result[]
  studentSubjectSelections StudentSubjectSelection[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("academic_sessions")
}

model Term {
  id                String          @id @default(uuid())
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  name              TermName
  startDate         DateTime
  endDate           DateTime
  isCurrent         Boolean         @default(false)

  attendanceRecords AttendanceRecord[]
  results           Result[]

  @@unique([academicSessionId, name])
  @@index([academicSessionId])
  @@map("terms")
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum SchoolLevel {
  NURSERY
  PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
}

/// Finer-grained than SchoolLevel: splits PRIMARY into Lower/Upper bands
/// (Primary 1-3 vs 4-6), which the Nigerian curriculum gives different core
/// subject lists to. Every SchoolClass carries exactly one of these; `level`
/// is always derived from it (ClassesService), never set independently, so
/// the two can never disagree. Subject.gradeTiers is scoped by this enum
/// instead of SchoolLevel for the same reason.
enum GradeTier {
  NURSERY
  LOWER_PRIMARY
  UPPER_PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
}

/// Senior Secondary science/art streaming. Only meaningful once a student's
/// current class is SENIOR_SECONDARY: StudentsService.setStream rejects
/// setting it otherwise. Subject.streams uses the same enum to tag which
/// stream(s) a subject belongs to.
enum Stream {
  SCIENCE
  ART
}

/// promotesToClassId is the admin-defined "next class" in the promotion
/// chain (e.g. JSS 1 -> JSS 2), set once when levels are configured, not
/// derived from name/order guessing. null means terminal: promoting a
/// student out of this class marks them GRADUATED instead of moving them
/// (see StudentsService's bulk promotion).
model SchoolClass {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId          String
  campus            Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name              String // e.g. "JSS 2"
  level             SchoolLevel  @default(JUNIOR_SECONDARY)
  /// Admin-facing scoping field (ClassesService derives `level` from this
  /// automatically); see the GradeTier doc comment.
  gradeTier         GradeTier    @default(JUNIOR_SECONDARY)
  order             Int          @default(0) // for sorting class levels
  promotesToClassId String?
  promotesToClass   SchoolClass? @relation("ClassPromotion", fields: [promotesToClassId], references: [id], onDelete: SetNull)
  promotedFromClasses SchoolClass[] @relation("ClassPromotion")
  createdAt         DateTime     @default(now())

  arms               ClassArm[]
  teacherAssignments TeacherSubjectAssignment[]

  @@unique([campusId, name])
  @@index([tenantId])
  @@map("school_classes")
}

model ClassArm {
  id             String        @id @default(uuid())
  schoolClassId  String
  schoolClass    SchoolClass   @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  name           String // e.g. "Gold"
  classTeacherId String?
  classTeacher   StaffProfile? @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  /// Which stream this arm is for, at Senior Secondary; admin-tagged
  /// (e.g. "Gold" -> SCIENCE, "Diamond" -> ART). null means not
  /// stream-specific (the normal case outside Senior Secondary). Random
  /// arm assignment for a Senior Secondary student is only drawn from
  /// arms tagged for their chosen stream: see StudentsService.applyStreamChange.
  stream         Stream?
  createdAt      DateTime      @default(now())

  students            Student[]
  attendanceRecords   AttendanceRecord[]
  studentClassHistory StudentClassHistory[]
  assignments         Assignment[]
  lessons             Lesson[]
  cbtExams            CbtExam[]
  timetableSlots      TimetableSlot[]

  @@unique([schoolClassId, name])
  @@map("class_arms")
}

/// gradeTiers: which GradeTier(s) this subject is taught at (e.g. "Further
/// Mathematics" is SENIOR_SECONDARY only; "Pre-Vocational Studies" spans
/// UPPER_PRIMARY and JUNIOR_SECONDARY, but not LOWER_PRIMARY). Empty means
/// "not yet configured"; SubjectsService.assignTeacher treats that as "any
/// grade tier" rather than blocking every assignment.
model Subject {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  gradeTiers GradeTier[]
  /// Which stream(s) this subject belongs to at Senior Secondary (e.g.
  /// Physics -> [SCIENCE], Literature -> [ART]). Empty means "any
  /// stream", same "empty = unconfigured, not blocking" convention as
  /// `gradeTiers` (see SubjectsService.listSubjects) — EXCEPT for a
  /// Senior Secondary subject that is neither `isCompulsory` nor
  /// `isCoreTrade`: for those, `streams` must be non-empty
  /// (SubjectsService enforces this at create/update time), since a
  /// student's stream is what decides which electives they're offered.
  streams   Stream[] @default([])
  /// Auto-included in every Senior Secondary student's subject selection
  /// (StudentsService.setSubjectSelection) regardless of `streams` — e.g.
  /// English Language, Mathematics.
  isCompulsory Boolean @default(false)
  /// One of these is required in every Senior Secondary student's
  /// selection (their choice of trade), independent of `streams` — e.g.
  /// Solar PV Installation and Maintenance. Mutually exclusive with
  /// `isCompulsory` (SubjectsService rejects both being true).
  isCoreTrade  Boolean @default(false)
  createdAt DateTime @default(now())

  teacherAssignments TeacherSubjectAssignment[]
  results            Result[]
  assignments        Assignment[]
  lessons            Lesson[]
  cbtExams           CbtExam[]
  timetableSlots     TimetableSlot[]
  studentSelections  StudentSubjectSelection[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

/// Which teacher may enter/submit results and take attendance for which
/// class + subject. This is the scoping table the Teacher role's guards
/// should check against, not a hardcoded "teacher owns a class" field.
model TeacherSubjectAssignment {
  id             String       @id @default(uuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  schoolClassId  String
  schoolClass    SchoolClass  @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([staffProfileId, schoolClassId, subjectId])
  @@index([schoolClassId])
  @@map("teacher_subject_assignments")
}

// ─────────────────────────────────────────────────────────────────────────
// People: Staff, Students, Guardians
// ─────────────────────────────────────────────────────────────────────────

/// Thin shell for now; deep HR fields (contracts, qualifications,
/// documents, leave, salary structure) land in Phase 3. Every staff member
/// with system access has a linked User; give this table a stable id
/// other modules (payroll, HR) can reference later without migration pain.
model StaffProfile {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusId       String
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  staffId        String // human-facing employee number, generated via NumberingSequence
  employmentType String? // e.g. "full_time", "part_time", "contract"; kept loose pre-Phase-3
  department     String?
  position       String?
  dateJoined     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  classArmsLed       ClassArm[]
  teacherAssignments TeacherSubjectAssignment[]
  attendanceRecords  AttendanceRecord[] // as recorder is on User; this is for staff's own attendance in later phases
  assignmentsCreated Assignment[]
  lessonsCreated     Lesson[]
  cbtExamsCreated    CbtExam[]
  timetableSlots     TimetableSlot[]

  @@unique([tenantId, staffId])
  @@index([tenantId])
  @@index([campusId])
  @@map("staff_profiles")
}

enum StudentStatus {
  APPLICANT
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
  ARCHIVED
}

model Student {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId    String
  campus      Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  admissionNo String // human-facing, generated via NumberingSequence
  status      StudentStatus @default(ACTIVE)

  firstName   String
  lastName    String
  middleName  String?
  dateOfBirth DateTime?
  gender      String?
  photoUrl    String?

  medicalNotes          String?
  emergencyContactName  String?
  emergencyContactPhone String?

  currentClassArmId String?
  currentClassArm   ClassArm? @relation(fields: [currentClassArmId], references: [id], onDelete: SetNull)

  /// Science/Art stream, only settable while the student's current class
  /// is SENIOR_SECONDARY (StudentsService.setStream). Settable by the
  /// student themselves (student portal) or by PROPRIETOR/PRINCIPAL.
  stream Stream?

  // Optional login for the Student portal (Phase 4); nullable because many
  // students in Phase 1 won't have portal access yet.
  userId String? @unique
  user   User?   @relation("StudentUserAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardianLinks     StudentGuardian[]
  attendanceRecords AttendanceRecord[]
  results           Result[]
  classHistory      StudentClassHistory[]
  cbtAttempts       CbtAttempt[]
  streamChangeRequests StreamChangeRequest[]
  subjectSelections StudentSubjectSelection[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId])
  @@index([campusId])
  @@index([currentClassArmId])
  @@map("students")
}

/// Promotion/transfer trail. One row per (student, academic session) at
/// minimum; also used to record mid-session class/arm transfers.
model StudentClassHistory {
  id                String          @id @default(uuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  classArmId        String
  classArm          ClassArm        @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  effectiveFrom     DateTime        @default(now())
  reason            String? // e.g. "promotion", "transfer", "initial enrollment"

  @@index([studentId])
  @@index([academicSessionId])
  @@map("student_class_history")
}

enum StreamChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Self-service stream-switch requests. Only a student in their first
/// Senior Secondary class may create one (ClassesService.isEntrySeniorSecondaryClass
/// StudentsService.requestStreamChange enforces it); an admin
/// (PROPRIETOR/PRINCIPAL) reviews and approves/rejects. Approving moves
/// Student.stream and, if the class has an arm tagged for the new
/// stream, the student into it (StudentsService.applyStreamChange), a
/// request never changes anything on its own until reviewed, same
/// "no silent rewrite" discipline as promotion.
model StreamChangeRequest {
  id               String                    @id @default(uuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedStream  Stream
  status           StreamChangeRequestStatus @default(PENDING)
  reason           String?
  reviewedByUserId String?
  reviewedBy       User?                     @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNote       String?
  createdAt        DateTime                  @default(now())
  reviewedAt       DateTime?

  @@index([tenantId, status])
  @@index([studentId])
  @@map("stream_change_requests")
}

/// One row per (student, subject, session) a Senior Secondary student is
/// taking — compulsory, trade, and stream-elective subjects all land here
/// the same way once selected (StudentsService.setSubjectSelection); no
/// special-casing at read time. Resubmitting a selection replaces the
/// whole row-set for that session in a transaction, it doesn't append.
model StudentSubjectSelection {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  selectedAt        DateTime        @default(now())

  @@unique([studentId, subjectId, academicSessionId])
  @@index([tenantId])
  @@index([studentId, academicSessionId])
  @@map("student_subject_selections")
}

/// A parent/guardian account. May have a login (Parent portal, Phase 4-ish
/// but the account shell is useful now) and links to one or more Students
/// via StudentGuardian, with a relationship type per link.
model Guardian {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentLinks StudentGuardian[]

  @@index([tenantId])
  @@map("guardians")
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

/// Join table supporting multiple guardians per student and multiple
/// children per guardian. isPrimary marks the main contact/payer.
model StudentGuardian {
  id           String               @id @default(uuid())
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

// ─────────────────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// A TEACHER's correction lands PENDING and has no effect on the
/// "official" status until a PROPRIETOR/PRINCIPAL reviews it, a
/// PROPRIETOR/PRINCIPAL correction is self-approved (they are the admin).
/// PENDING/REJECTED rows never change what AttendanceService.list()
/// resolves as current; only the latest APPROVED row (or the original, if
/// none) does. null on the original (non-correction) row.
enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Corrections must not overwrite history: write a new record with
/// correctionOf pointing at the original, correctionReason populated, and
/// an AuditLog entry. Application code enforces this; the schema just
/// carries the fields.
model AttendanceRecord {
  id               String                      @id @default(uuid())
  tenantId         String
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId         String
  campus           Campus                      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classArmId       String
  classArm         ClassArm                    @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  termId           String
  term             Term                        @relation(fields: [termId], references: [id], onDelete: Cascade)
  date             DateTime                    @db.Date
  status           AttendanceStatus
  recordedById     String
  recordedBy       User                        @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  correctionOf     String?
  correctionReason String?
  correctionStatus AttendanceCorrectionStatus?
  rejectionReason  String?
  staffProfileId   String? // set when this row is a staff attendance record (future use)
  staffProfile     StaffProfile?               @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  createdAt        DateTime                    @default(now())

  @@unique([studentId, date, correctionOf], map: "uniq_student_date_correction")
  @@index([tenantId, campusId, date])
  @@index([classArmId, date])
  @@index([tenantId, correctionStatus])
  @@map("attendance_records")
}

// ─────────────────────────────────────────────────────────────────────────
// Results (basic; full grading-scale configuration is a later refinement)
// ─────────────────────────────────────────────────────────────────────────

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

/// State machine: DRAFT -> SUBMITTED -> APPROVED -> PUBLISHED. Teachers may
/// create/submit; only Principal/Proprietor may approve or publish;
/// enforce in guards, not here. Any status transition must be audited.
model Result {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  termId            String
  term              Term            @relation(fields: [termId], references: [id], onDelete: Cascade)

  continuousAssessmentScore Decimal? @db.Decimal(5, 2)
  examScore                 Decimal? @db.Decimal(5, 2)
  totalScore                Decimal? @db.Decimal(5, 2)
  grade                     String?
  teacherComment            String?

  status      ResultStatus @default(DRAFT)
  enteredById String
  enteredBy   User         @relation("ResultEnteredBy", fields: [enteredById], references: [id])
  submittedAt DateTime?
  approvedAt  DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId])
  @@index([tenantId])
  @@index([termId, subjectId])
  @@map("results")
}

/// One band of a school's grading scale (e.g. "A" = 70-100). Proprietor-
/// managed; Result.grade is computed against these bands once, at result
/// creation time, and stored: a later scale edit never retroactively
/// rewrites a grade already on the books (same "no silent rewrite of the
/// past" principle as everything else ledger-like in this schema).
model GradeBand {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade     String // e.g. "A"
  minScore  Int // inclusive
  maxScore  Int // inclusive
  meaning   String? // e.g. "Excellent"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, grade])
  @@index([tenantId])
  @@map("grade_bands")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 4: Portals & Communication
// See PHASE_4_PORTALS_COMMUNICATION.md. Built on top of Phase 0+1 only;
// nothing here assumes fees/payroll (Phase 2/3) exist.
// ─────────────────────────────────────────────────────────────────────────

enum CommunicationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum AnnouncementAudience {
  SCHOOL
  CAMPUS
  CLASS
  ARM
  PARENT_GROUP
  INDIVIDUAL
}

/// In-app notification a user sees in their portal. Always-on regardless
/// of which external providers (if any) are configured.
model Notification {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User      @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String // e.g. "RESULT_PUBLISHED", "ATTENDANCE_ALERT", "ANNOUNCEMENT"
  title           String
  body            String
  entityType      String?
  entityId        String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

/// Reusable message template for announcements, notices, and (later)
/// payment reminders. `placeholders` documents the merge fields the
/// template body expects (e.g. ["studentName", "className"]).
model MessageTemplate {
  id           String               @id @default(uuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  channel      CommunicationChannel
  subject      String?
  body         String
  placeholders Json                 @default("[]")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  communicationLogs CommunicationLog[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("message_templates")
}

/// One row per actual send attempt, the delivery-status/history record
/// the spec asks for. Distinct from AuditLog: this is operational
/// communication history, not the sensitive-action audit trail.
model CommunicationLog {
  id                String               @id @default(uuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderUserId      String?
  sender            User?                @relation("CommunicationSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  channel           CommunicationChannel
  templateId        String?
  template          MessageTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientUserId   String?
  recipient         User?                @relation("CommunicationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientContact  String? // email/phone snapshot at send time
  targetDescription String // e.g. "JSS 2 Gold parents"
  subject           String?
  body              String
  status            CommunicationStatus  @default(QUEUED)
  providerRef       String?
  dedupeKey         String // entityType+entityId+eventType+recipientId: idempotent sends
  sentAt            DateTime?
  createdAt         DateTime             @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
  @@index([recipientUserId])
  @@map("communication_logs")
}

/// Thin: a teacher posts an assignment to a class; students/parents can
/// view it. No submission/grading pipeline yet.
model Assignment {
  id                      String        @id @default(uuid())
  tenantId                String
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArmId              String
  classArm                ClassArm      @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subjectId               String?
  subject                 Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // Nullable: PROPRIETOR/PRINCIPAL can post administratively without
  // being a teacher (no StaffProfile of their own); see AssignmentsService.
  createdByStaffProfileId String?
  createdByStaffProfile   StaffProfile? @relation(fields: [createdByStaffProfileId], references: [id], onDelete: SetNull)
  title                   String
  description             String
  resourceUrl             String?
  dueDate                 DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([tenantId])
  @@index([classArmId])
  @@map("assignments")
}

/// A teacher's lesson note for one of their assigned (class arm, subject)
/// pairs, with zero or more attached resources. Teacher-authored only,
/// unlike Assignment, PROPRIETOR/PRINCIPAL don't post lessons themselves,
/// only view them (see LessonsService).
model Lesson {
  id                      String       @id @default(uuid())
  tenantId                String
  tenant                  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArmId              String
  classArm                ClassArm     @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subjectId               String
  subject                 Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdByStaffProfileId String
  createdByStaffProfile   StaffProfile @relation(fields: [createdByStaffProfileId], references: [id], onDelete: Cascade)
  title                   String
  notes                   String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  resources LessonResource[]

  @@index([tenantId])
  @@index([classArmId])
  @@map("lessons")
}

/// One hop from tenantId, reached only through its parent Lesson, which
/// is itself tenant-scoped. Same pattern as ClassArm/TeacherSubjectAssignment;
/// see tenant-scoping.extension.ts's doc comment for why this deliberately
/// has no tenantId column of its own.
model LessonResource {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name      String
  type      String
  url       String?
  createdAt DateTime @default(now())

  @@index([lessonId])
  @@map("lesson_resources")
}

/// Drives bulk announcements. `audienceRefId` is interpreted per
/// `audience` (a Campus id, SchoolClass id, ClassArm id, etc.),
/// recipients are resolved from the tenant-scoped roster at send time,
/// never accepted as a client-supplied list (rule #2 in this phase's doc).
model Announcement {
  id              String               @id @default(uuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId        String?
  campus          Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  audience        AnnouncementAudience
  audienceRefId   String?
  title           String
  body            String
  createdByUserId String
  createdByUser   User                 @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  publishedAt     DateTime?
  createdAt       DateTime             @default(now())

  @@index([tenantId])
  @@map("announcements")
}

// ─────────────────────────────────────────────────────────────────────────
// CBT (computer-based tests): teacher-authored, principal/proprietor
// reviewed before students can attempt. State machine: DRAFT -> SUBMITTED
// -> PUBLISHED, with SUBMITTED -> DRAFT on rejection (rejectionReason set).
// ─────────────────────────────────────────────────────────────────────────

enum CbtExamStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

enum CbtAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

/// A teacher-authored, auto-graded multiple-choice test for one (class arm,
/// subject) pair. Mirrors Result's review discipline (a student's score is
/// effectively a result) rather than Lesson/Assignment's post-immediately
/// model: DRAFT -> SUBMITTED (teacher) -> PUBLISHED (principal/proprietor),
/// or back to DRAFT with rejectionReason set. Only a PUBLISHED exam is ever
/// visible to STUDENT/PARENT; see CbtExamsService.assertReadAccess.
model CbtExam {
  id                      String        @id @default(uuid())
  tenantId                String
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArmId              String
  classArm                ClassArm      @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subjectId               String
  subject                 Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdByStaffProfileId String
  createdByStaffProfile   StaffProfile  @relation(fields: [createdByStaffProfileId], references: [id], onDelete: Cascade)
  title                   String
  durationMinutes         Int
  status                  CbtExamStatus @default(DRAFT)
  rejectionReason         String?
  submittedAt             DateTime?
  publishedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  questions CbtQuestion[]
  attempts  CbtAttempt[]

  @@index([tenantId])
  @@index([classArmId])
  @@map("cbt_exams")
}

/// One hop from tenantId, reached only through its parent CbtExam, itself
/// tenant-scoped. Same pattern as LessonResource; see
/// tenant-scoping.extension.ts's doc comment.
model CbtQuestion {
  id     String  @id @default(uuid())
  examId String
  exam   CbtExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  text   String
  order  Int     @default(0)

  options CbtOption[]
  answers CbtAnswer[]

  @@index([examId])
  @@map("cbt_questions")
}

/// isCorrect must never be sent to a STUDENT/PARENT before/while an exam is
/// in progress; CbtExamsService strips it for those roles. One hop from
/// tenantId, same as CbtQuestion.
model CbtOption {
  id         String      @id @default(uuid())
  questionId String
  question   CbtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean     @default(false)
  order      Int         @default(0)

  answers CbtAnswer[]

  @@index([questionId])
  @@map("cbt_options")
}

/// One row per (exam, student); the unique constraint is what makes
/// "start attempt" idempotent/resumable rather than creating duplicates.
/// One hop from tenantId, reached through examId/studentId.
model CbtAttempt {
  id          String           @id @default(uuid())
  examId      String
  exam        CbtExam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      CbtAttemptStatus @default(IN_PROGRESS)
  score       Int?
  totalMarks  Int?
  startedAt   DateTime         @default(now())
  submittedAt DateTime?

  answers CbtAnswer[]

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("cbt_attempts")
}

/// Graded at submit time (CbtExamsService.submitAttempt computes isCorrect
/// by comparing selectedOptionId against the question's flagged-correct
/// option), never recomputed on read. One hop from tenantId.
model CbtAnswer {
  id               String      @id @default(uuid())
  attemptId        String
  attempt          CbtAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         CbtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   CbtOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect        Boolean     @default(false)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("cbt_answers")
}

// ─────────────────────────────────────────────────────────────────────────
// Timetable: generated from TeacherSubjectAssignment, one weekly grid per
// ClassArm. Regenerating replaces every slot for the tenant; a slot is
// never hand-edited into a state the generator couldn't have produced,
// since the two uniques below are exactly the conflict rules the generator
// enforces (a class arm sees one subject per period, a teacher is in one
// place per period), the DB is a second line of defense, not just the
// generator's own bookkeeping.
// ─────────────────────────────────────────────────────────────────────────

/// One per tenant: the shape of the school day the generator builds
/// periods against (TimetableService.getSettings lazily creates one with
/// sensible defaults on first read, rather than requiring a seed step).
/// Period duration is fixed at 30 minutes app-wide (TIMETABLE.PERIOD_DURATION_MINUTES,
/// not stored here); only the day's start/end and its break windows are
/// admin-configurable.
model TimetableSettings {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayStartTime  String   @default("08:00") // "HH:mm", 24h
  dayEndTime    String   @default("14:00")
  updatedAt     DateTime @updatedAt

  breaks TimetableBreak[]

  @@map("timetable_settings")
}

/// A named window (e.g. "Short break", "Lunch") the generator treats as
/// non-schedulable; TimetableGenerator.buildPeriods jumps straight from
/// a break's start to its end rather than placing a period across it. One
/// hop from tenantId, reached through its parent TimetableSettings (same
/// pattern as ClassArm/Term (see tenant-scoping.extension.ts).
model TimetableBreak {
  id                  String            @id @default(uuid())
  timetableSettingsId String
  timetableSettings   TimetableSettings @relation(fields: [timetableSettingsId], references: [id], onDelete: Cascade)
  label               String
  startTime           String // "HH:mm"
  endTime             String
  order               Int               @default(0)

  @@index([timetableSettingsId])
  @@map("timetable_breaks")
}

enum DocumentTemplateStatus {
  DRAFT
  PUBLISHED
}

/// A printable/exportable document's editable body (report card, fee
/// invoice, admission letter, payment receipt, ...), keyed by a stable
/// `key` so the report-card generator (etc.) always knows which template
/// to render against, independent of its human-facing `name`. Editing
/// never overwrites the published version in place: it bumps `version`
/// and flips to DRAFT, so whatever is currently live keeps rendering
/// exactly as-is for anyone generating a document until a PROPRIETOR
/// deliberately publishes the new draft (mirrors GradingScale's "never
/// recalculate published records" philosophy).
model DocumentTemplate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key         String // stable identifier, e.g. "REPORT_CARD"
  name        String
  content     String // template body, "{{merge.field}}" placeholders
  mergeFields String[] // documents which placeholders this template supports

  status      DocumentTemplateStatus @default(DRAFT)
  version     Int                    @default(1)
  updatedById String?
  updatedBy   User?                  @relation("DocumentTemplateUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("document_templates")
}

model TimetableSlot {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArmId     String
  classArm       ClassArm     @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 1=Monday .. 5=Friday
  periodIndex    Int // 0-based index into the day's period list (8:00am-2:00pm, 8 periods)
  startTime      String // "08:00", 24h HH:mm; denormalized for display, derived from periodIndex at generation time
  endTime        String
  createdAt      DateTime     @default(now())

  // Multiple subjects can now share a cell (Trade/Elective block periods —
  // see TimetableService.generate): different subjects, different
  // teachers, same class-arm/day/period. staffProfileId's own unique
  // index below is what still guarantees no teacher is double-booked.
  @@unique([classArmId, dayOfWeek, periodIndex, subjectId])
  @@unique([staffProfileId, dayOfWeek, periodIndex])
  @@index([tenantId])
  @@map("timetable_slots")
}
